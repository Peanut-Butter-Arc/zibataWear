# Supabase (Public client credentials)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Public Application URL (used for auth redirects, Stripe return URLs, and CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Checkout (Phase 2 - add Test or Live keys when activating live payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase Service Role / Secret Key (server-only, required for Stripe webhook persistence)
SUPABASE_SERVICE_ROLE_KEY=

# Optional Capacitor remote URL for native iOS/Android live reload or production shell
CAPACITOR_SERVER_URL=https://zibatawear.vercel.app
